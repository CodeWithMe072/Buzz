# Server
PORT=5500
NODE_ENV=DEV
CLIENT_URL=http://127.0.0.1:5500

# MongoDB
MONGO_URI=mongodb://localhost:27017/chatapp

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use a long random string, never commit the real value
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_separate_refresh_secret_change_this_in_production
JWT_EXPIRES_IN=7d

# Media encryption
MEDIA_ENCRYPTION_KEY=your_long_random_media_encryption_key
MEDIA_ENCRYPTION_KEY_v1=your_long_random_media_encryption_key_v1

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
 
# Telegram Bot
TELEGRAM_BOT_TOKEN=
