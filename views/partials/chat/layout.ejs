<div id="chat-screen" class="chat-screen active">
    <div class="chat-layout">
        <!-- App Navbar (Vertical / Bottom Bar) -->
        <div class="app-navbar">
            <div class="nav-top">
                <button type="button" class="nav-item active" id="nav-chat-btn" title="Chats">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span class="nav-badge" id="nav-chat-badge" style="display: none;">0</span>
                </button>
                <button type="button" class="nav-item" id="nav-status-btn" title="Status">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <circle cx="12" cy="12" r="6"></circle>
                        <circle cx="12" cy="12" r="2"></circle>
                    </svg>
                    <span class="nav-dot" id="nav-status-dot" style="display: none;"></span>
                </button>
            </div>
            <div class="nav-bottom">
                <button type="button" id="nav-avatar-btn" title="Profile & Settings">
                    <span id="nav-avatar-text">U</span>
                </button>
            </div>
        </div>

        <!-- Chat List Sidebar -->
        <aside class="chat-list-sidebar" id="chat-list-sidebar">
            <div class="chat-list-header">
                <div class="user-profile">
                    <div class="avatar" id="current-user-avatar"><span>U</span></div>
                    <span id="current-username">User</span>
                </div>
                <div class="header-actions">
                    <!-- Add People Button with badge -->
                    <button class="icon-btn people-btn" id="add-people-btn" title="Account & People Hub">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <span class="requests-badge" id="requests-badge" style="display:none">0</span>
                    </button>
                </div>
            </div>

            <div class="chat-list-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" placeholder="Search conversations..." id="chat-search">
            </div>

            <div class="chat-list" id="chat-list"></div>
        </aside>

        <!-- Status Sidebar (NEW!) -->
        <aside class="status-sidebar hidden" id="status-sidebar">
            <div class="status-sidebar-header">
                <h2>Status</h2>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <!-- Gallery upload trigger -->
                    <input type="file" id="status-gallery-input" accept="image/*,video/*" style="display: none;" />
                    <!-- Plus Button (open status composer) -->
                    <button class="icon-btn" id="status-composer-trigger-btn" title="Create status update">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </button>
                    <!-- Options Menu -->
                    <button class="icon-btn" id="status-options-btn" title="Status Options">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="1.5"></circle>
                            <circle cx="12" cy="5" r="1.5"></circle>
                            <circle cx="12" cy="19" r="1.5"></circle>
                        </svg>
                    </button>
                </div>
            </div>
            
            <div class="my-status-section">
                <div class="my-status-card" id="my-status-item">
                    <div class="avatar-container" style="position: relative; width: 48px; height: 48px; border-radius: 50%; background: var(--elevated-bg); border: 2px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 14px; flex-shrink: 0;">
                        <span id="my-status-avatar-text">ME</span>
                        <span class="status-add-badge">+</span>
                    </div>
                    <div class="my-status-info">
                        <div class="my-status-name">My Status</div>
                        <div class="my-status-subtext">Click to add status update</div>
                    </div>
                </div>
            </div>

            <div class="recent-updates-title" id="status-recent-title" style="display: none;">Recent Updates</div>
            <div id="status-sidebar-list">
                <!-- Status items populated dynamically -->
            </div>
        </aside>

        <!-- Profile Page Options Sidebar -->
        <aside class="profile-page-sidebar hidden" id="profile-page-sidebar" style="display: none;">
            <div class="profile-modal-sidebar" style="width: 100%; height: 100%; border: none;">
                <div class="profile-modal-avatar-wrap">
                    <div class="profile-modal-avatar-ring"></div>
                    <div class="profile-modal-avatar-letter" id="profile-modal-avatar-letter">U</div>
                </div>
                <h3 class="profile-modal-username" id="profile-modal-username">Username</h3>
                <p class="profile-modal-email" id="profile-modal-email">email@example.com</p>

                <div class="profile-modal-nav">
                    <button class="profile-nav-btn" data-section="account">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        Account Settings
                    </button>
                    <button class="profile-nav-btn" data-section="search">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        Discover
                    </button>
                    <button class="profile-nav-btn" data-section="pending">
                        <div style="position: relative; display: flex; align-items: center;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            <span class="tab-badge" id="requests-badge-profile" style="display:none">0</span>
                        </div>
                        Requests
                    </button>
                    <button class="profile-nav-btn" data-section="contacts">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Contacts
                    </button>
                    <button class="profile-nav-btn" data-section="moments">
                        <div style="position: relative; display: flex; align-items: center;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="2" y1="12" x2="22" y2="12" />
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                            </svg>
                            <span class="tab-badge" id="modal-moments-badge" style="display:none"></span>
                        </div>
                        Moments
                    </button>
                    <button class="profile-nav-btn" data-section="whitelist">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        Moments Whitelist
                    </button>
                    <button class="profile-nav-btn" data-section="logs">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                            <circle cx="12" cy="13" r="4" />
                        </svg>
                        Security Logs
                    </button>
                </div>
                <button class="profile-modal-logout-btn" id="profile-modal-logout-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    Log Out
                </button>
            </div>
        </aside>

        <!-- Chat Window Placeholder -->
        <main class="chat-window" id="chat-window">
            <!-- Dynamic message window or empty state will load here -->
        </main>

        <!-- Contact Info Right Sidebar (WhatsApp Web Style) -->
        <aside class="contact-info-sidebar hidden" id="contact-info-sidebar">
            <div class="contact-info-header">
                <button type="button" class="icon-btn" id="contact-info-close-btn" title="Close">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
                <span class="contact-info-title">Contact info</span>
            </div>

            <div class="contact-info-body">
                <div class="contact-info-card hero-card">
                    <div class="contact-info-avatar-wrap">
                        <div class="contact-info-avatar-ring"></div>
                        <div class="contact-info-avatar-letter" id="contact-sidebar-avatar">U</div>
                    </div>
                    <h2 class="contact-info-name" id="contact-sidebar-name">User</h2>
                    <p class="contact-info-sub" id="contact-sidebar-sub">Active now</p>

                    <div class="contact-info-actions">
                        <button type="button" class="contact-action-btn" id="contact-action-voice">
                            <div class="contact-action-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.18 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.57a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                            </div>
                            <span>Voice</span>
                        </button>
                        <button type="button" class="contact-action-btn" id="contact-action-video">
                            <div class="contact-action-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polygon points="23 7 16 12 23 17 23 7"/>
                                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                                </svg>
                            </div>
                            <span>Video</span>
                        </button>
                        <button type="button" class="contact-action-btn" id="contact-action-search">
                            <div class="contact-action-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="11" cy="11" r="8"/>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                </svg>
                            </div>
                            <span>Search</span>
                        </button>
                    </div>
                </div>

                <div class="contact-info-card media-card">
                    <div class="contact-info-card-header" id="contact-media-header">
                        <span class="contact-card-title">Media, links and docs</span>
                        <span class="contact-card-count" id="contact-media-count">0 &rsaquo;</span>
                    </div>
                    <div class="contact-media-preview-grid" id="contact-media-grid">
                        <div class="contact-media-empty">No media shared yet</div>
                    </div>
                </div>

                <div class="contact-info-card settings-card">
                    <div class="contact-info-row" id="contact-starred-row">
                        <div class="contact-row-left">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                            </svg>
                            <span>Starred messages</span>
                        </div>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </div>

                    <div class="contact-info-row" id="contact-mute-row">
                        <div class="contact-row-left">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                            </svg>
                            <span>Notification settings</span>
                        </div>
                        <label class="switch">
                            <input type="checkbox" id="contact-mute-toggle">
                            <span class="slider"></span>
                        </label>
                    </div>

                    <div class="contact-info-row" id="contact-disappearing-row">
                        <div class="contact-row-left">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12 6 12 12 16 14"/>
                            </svg>
                            <div style="display: flex; flex-direction: column;">
                                <span>Disappearing messages</span>
                                <small style="color: var(--text-secondary); font-size: 11px;">Off</small>
                            </div>
                        </div>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                    </div>

                    <div class="contact-info-row">
                        <div class="contact-row-left">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            <div style="display: flex; flex-direction: column;">
                                <span>Encryption</span>
                                <small style="color: var(--text-secondary); font-size: 11px;">Messages are end-to-end encrypted</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="contact-info-card danger-card">
                    <div class="contact-info-row danger-row" id="contact-block-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                        </svg>
                        <span style="color: #ef4444;">Block Contact</span>
                    </div>

                    <div class="contact-info-row danger-row" id="contact-clear-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                        </svg>
                        <span style="color: #ef4444;">Clear Chat</span>
                    </div>
                </div>
            </div>

            <!-- ── Media Gallery Panel (replaces contact-info-body) ── -->
            <div class="media-gallery-panel hidden" id="media-gallery-panel">
                <div class="media-gallery-header">
                    <button type="button" class="icon-btn" id="media-gallery-back-btn" title="Back">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                    </button>
                    <span class="media-gallery-title">Media, docs and links</span>
                </div>
                <div class="media-gallery-tabs">
                    <button class="media-gallery-tab active" data-tab="media">Media</button>
                    <button class="media-gallery-tab" data-tab="docs">Docs</button>
                    <button class="media-gallery-tab" data-tab="links">Links</button>
                </div>
                <div class="media-gallery-content" id="media-gallery-content">
                    <div class="media-gallery-loading">Loading...</div>
                </div>
            </div>
            <!-- ── End Media Gallery Panel ── -->
        </aside>
    </div>
</div>
