<div class="media-viewer-overlay" id="mediaViewer">
    <div class="viewer-header">
        <div class="viewer-left">
            <button class="viewer-action-btn back-btn" id="viewerBack" title="Back" style="display: none; margin-right: 8px;"><i class="ti ti-arrow-left"></i></button>
            <img class="viewer-avatar" id="viewerAvatar" src="/images/default-avatar.png" alt="Avatar">
            <div class="viewer-avatar-fallback" id="viewerAvatarFallback" style="display: none;"></div>
            <div class="viewer-meta">
                <span class="sender-name" id="viewerSenderName">You</span>
                <span class="media-time" id="viewerMediaTime">Today at 1:54 pm</span>
            </div>
            <span class="media-counter">
                <span id="currentIndex"></span> of <span id="totalMedia"></span>
            </span>
        </div>
        <div class="viewer-actions">
            <button class="viewer-action-btn zoom-out-btn" id="viewerZoomOut" title="Zoom out"><i class="ti ti-zoom-out"></i></button>
            <button class="viewer-action-btn zoom-in-btn" id="viewerZoomIn" title="Zoom in"><i class="ti ti-zoom-in"></i></button>
            <button class="viewer-action-btn rotate-btn" id="viewerRotate" title="Rotate"><i class="ti ti-rotate"></i></button>
            <button class="viewer-action-btn star-btn" id="viewerStar" title="Star"><i class="ti ti-star"></i></button>
            <button class="viewer-action-btn pin-btn" id="viewerPin" title="Pin"><i class="ti ti-pin"></i></button>
            <button class="viewer-action-btn react-btn" id="viewerReact" title="React"><i class="ti ti-mood-smile"></i></button>
            <button class="viewer-action-btn reply-btn" id="viewerReply" title="Reply"><i class="ti ti-arrow-back-up"></i></button>
            <button class="viewer-action-btn forward-btn" id="viewerForward" title="Forward"><i class="ti ti-arrow-forward-up"></i></button>
            <button class="viewer-action-btn download-btn" id="viewerDownload" title="Download"><i class="ti ti-download"></i></button>
            <button class="viewer-action-btn more-btn" id="viewerMore" title="More options"><i class="ti ti-dots-vertical"></i></button>
            <button class="viewer-action-btn close-btn" id="closeViewer" title="Close"><i class="ti ti-x"></i></button>
        </div>
    </div>
    <div class="viewer-main" id="viewerMain">
        <button class="nav-arrow left" id="prevBtn">‹</button>
        <div class="media-container" id="mediaContainer"></div>
        <button class="nav-arrow right" id="nextBtn">›</button>
    </div>
    <div class="thumbnail-strip">
        <div class="thumbnail-container" id="thumbnailContainer"></div>
    </div>
</div>
